generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

enum MembershipStatus {
  FREE
  PENDING
  PREMIUM
  EXPIRED
}

enum ContentType {
  NOTE
  PYQ
  SYLLABUS
  LAB_MANUAL
  ASSIGNMENT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  NEW_NOTE
  NEW_PYQ
  ANNOUNCEMENT
  SYSTEM
  LISTING_APPROVED
  LISTING_REJECTED
  REFERRAL_JOINED
  REFERRAL_VALIDATED
  REFERRAL_MILESTONE_CLOSE
  REFERRAL_PREMIUM_ACTIVATED
  BUG_REPORT_RECEIVED
  BUG_REPORT_STATUS_CHANGED
  BUG_REPORT_RESOLVED
}

enum ReferralStatus {
  PENDING
  VALID
  INVALID
}

enum BugCategory {
  UI_ISSUE
  PERFORMANCE
  PDF_ISSUE
  LOGIN_PROBLEM
  PAYMENT_ISSUE
  PREMIUM_ISSUE
  WRONG_CONTENT
  MISSING_NOTES
  MISSING_PYQS
  SECURITY_ISSUE
  FEATURE_REQUEST
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  FIXED
  CLOSED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MerchCategory {
  ELECTRONICS
  BOOKS_NOTES
  COOKING_APPLIANCES
  CYCLES
  FURNITURE
  CLOTHING
  SPORTS_FITNESS
  STATIONERY
  OTHER
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  college            String?
  university         String?
  role               Role             @default(STUDENT)
  membershipStatus   MembershipStatus @default(FREE)
  membershipExpiry   DateTime?
  isBanned           Boolean          @default(false)
  // @default(cuid()) exists so NextAuth's PrismaAdapter — which creates
  // Google sign-in users directly via prisma.user.create() and has no idea
  // this column exists — never violates the NOT NULL/unique constraint.
  // events.createUser in lib/auth.ts immediately replaces it with a proper
  // short generated code.
  referralCode       String           @unique @default(cuid())
  referredById       String?
  referralRewardedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  accounts           Account[]
  sessions           Session[]
  bookmarks          Bookmark[]
  downloads          Download[]
  views              View[]
  paymentRequests    PaymentRequest[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  merchListings      MerchListing[]   @relation("MerchSeller")
  merchSaves         MerchSave[]
  referredBy         User?            @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]           @relation("Referrals")
  referralsMade      Referral[]       @relation("ReferrerOf")
  referralAsReferred Referral?        @relation("ReferredAs")
  referralRewards    ReferralReward[]
  bugReports         BugReport[]
  bugComments        BugComment[]

  @@index([email])
  @@index([membershipStatus])
  @@index([referralCode])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  shortName String    @unique
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  label     String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  branchId    String
  semesterId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  semester    Semester @relation(fields: [semesterId], references: [id])
  notes       Note[]
  pyqs        PYQ[]

  @@unique([name, branchId, semesterId])
  @@index([branchId, semesterId])
}

model Note {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description      String?
  contentType      ContentType @default(NOTE)
  subjectId        String
  branchId         String
  semesterId       String
  telegramFileId   String
  telegramMsgId    String
  thumbnailUrl     String?
  isPremium        Boolean     @default(false)
  isPublished      Boolean     @default(true)
  downloadCount    Int         @default(0)
  viewCount        Int         @default(0)
  fileSize         Int?
  totalPages       Int?
  uploadedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  subject          Subject     @relation(fields: [subjectId], references: [id])
  branch           Branch      @relation(fields: [branchId], references: [id])
  semester         Semester    @relation(fields: [semesterId], references: [id])
  bookmarks        Bookmark[]
  downloads        Download[]
  views            View[]
  tags             NoteTag[]
  academicBranch   String?
  academicSemester String?
  classYear        String?

  @@index([subjectId])
  @@index([branchId, semesterId])
  @@index([isPremium])
  @@index([viewCount])
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  tag    String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([tag])
}

model PYQ {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String?
  year             Int
  examType         String     @default("End Semester")
  subjectId        String
  branchId         String
  semesterId       String
  telegramFileId   String
  telegramMsgId    String
  isPremium        Boolean    @default(false)
  isPublished      Boolean    @default(true)
  downloadCount    Int        @default(0)
  viewCount        Int        @default(0)
  fileSize         Int?
  uploadedById     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  subject          Subject    @relation(fields: [subjectId], references: [id])
  branch           Branch     @relation(fields: [branchId], references: [id])
  semester         Semester   @relation(fields: [semesterId], references: [id])
  bookmarks        Bookmark[]
  downloads        Download[]
  views            View[]
  academicBranch   String?
  academicSemester String?
  classYear        String?

  @@index([year])
  @@index([branchId, semesterId])
  @@index([subjectId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@unique([userId, pyqId])
  @@index([userId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model View {
  id        String   @id @default(cuid())
  userId    String?
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([pyqId])
  @@index([createdAt])
}

model PaymentRequest {
  id             String        @id @default(cuid())
  userId         String
  transactionId  String
  screenshotUrl  String
  amount         Float         @default(299)
  status         PaymentStatus @default(PENDING)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  membershipDays Int           @default(365)
  telegramSent   Boolean       @default(true)
  telegramError  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  isActive  Boolean   @default(true)
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model MerchListing {
  id                   String               @id @default(cuid())
  title                String
  slug                 String               @unique
  category             MerchCategory
  price                Float
  isNegotiable         Boolean              @default(false)
  condition            ProductCondition
  description          String
  location             String?
  whatsapp             String
  sellerId             String
  status               ListingStatus        @default(PENDING)
  rejectionReason      String?
  awaitingCustomReason Boolean              @default(false)
  viewCount            Int                  @default(0)
  telegramMessageId    Int?
  telegramSent         Boolean              @default(false)
  telegramError        String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  seller               User                 @relation("MerchSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  images               MerchImage[]
  moderationLogs       MerchModerationLog[]
  saves                MerchSave[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model MerchImage {
  id        String       @id @default(cuid())
  listingId String
  url       String
  path      String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model MerchModerationLog {
  id        String       @id @default(cuid())
  listingId String
  action    String
  reason    String?
  adminId   String?
  createdAt DateTime     @default(now())
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model MerchSave {
  id        String       @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referrer      User           @relation("ReferrerOf", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String         @unique
  referred      User           @relation("ReferredAs", fields: [referredId], references: [id], onDelete: Cascade)
  status        ReferralStatus @default(PENDING)
  ipAddress     String?
  invalidReason String?
  validatedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([referrerId, status])
  @@index([createdAt])
}

model ReferralReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   Int
  grantedDays Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model BugReport {
  id               String       @id @default(cuid())
  bugId            String       @unique
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  title            String
  category         BugCategory
  description      String
  stepsToReproduce String?
  expectedBehavior String?
  actualBehavior   String?
  severity         BugSeverity  @default(MEDIUM)
  status           BugStatus    @default(SUBMITTED)
  priority         Int?
  pageUrl          String?
  browserInfo      String?
  deviceInfo       String?
  os               String?
  screenResolution String?
  appVersion       String?
  contactEmail     String?
  screenshotUrl    String?
  recordingUrl     String?
  internalNotes    String?
  ipAddress        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  comments         BugComment[]

  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
}

model BugComment {
  id        String    @id @default(cuid())
  bugId     String
  bug       BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isAdmin   Boolean   @default(false)
  message   String
  createdAt DateTime  @default(now())

  @@index([bugId])
}
