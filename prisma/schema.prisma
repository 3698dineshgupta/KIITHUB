generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

enum MembershipStatus {
  FREE
  PENDING
  PREMIUM
  EXPIRED
}

enum ContentType {
  NOTE
  PYQ
  SYLLABUS
  LAB_MANUAL
  ASSIGNMENT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  NEW_NOTE
  NEW_PYQ
  ANNOUNCEMENT
  SYSTEM
  LISTING_APPROVED
  LISTING_REJECTED
  REFERRAL_JOINED
  REFERRAL_VALIDATED
  REFERRAL_MILESTONE_CLOSE
  REFERRAL_PREMIUM_ACTIVATED
  BUG_REPORT_RECEIVED
  BUG_REPORT_STATUS_CHANGED
  BUG_REPORT_RESOLVED
  REQUEST_RECEIVED
  REQUEST_STATUS_CHANGED
  REQUEST_FULFILLED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  UPLOAD_REWARD_GRANTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  REJECTED
}

enum ReferralStatus {
  PENDING
  VALID
  INVALID
}

enum BugCategory {
  UI_ISSUE
  PERFORMANCE
  PDF_ISSUE
  LOGIN_PROBLEM
  PAYMENT_ISSUE
  PREMIUM_ISSUE
  WRONG_CONTENT
  MISSING_NOTES
  MISSING_PYQS
  SECURITY_ISSUE
  FEATURE_REQUEST
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  FIXED
  CLOSED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MerchCategory {
  ELECTRONICS
  BOOKS_NOTES
  COOKING_APPLIANCES
  CYCLES
  FURNITURE
  CLOTHING
  SPORTS_FITNESS
  STATIONERY
  OTHER
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  college            String?
  university         String?
  role               Role             @default(STUDENT)
  membershipStatus   MembershipStatus @default(FREE)
  membershipExpiry   DateTime?
  isBanned           Boolean          @default(false)
  // Bumped by the client-side presence heartbeat (every ~30s while a tab is
  // visible) — never by ordinary page requests, so a user with an idle
  // background tab doesn't read as "online". "Online now" is derived at
  // query time as lastActiveAt within the last ~90s (3 missed beats of
  // slack for network jitter), not stored as its own boolean.
  lastActiveAt       DateTime?
  // Incremented by a fixed 30s per accepted heartbeat rather than measured
  // wall-clock gaps — immune to clock skew and to a resumed/reopened tab
  // counting the hours it was closed as "time spent".
  totalTimeSpentSec  Int              @default(0)
  // Set once, the first time a user reaches 3 APPROVED ContentSubmissions —
  // never reset or re-granted on later uploads (one-time reward). Null means
  // never earned. The 15-day access window is computed from this timestamp,
  // not stored separately.
  uploadRewardGrantedAt DateTime?
  // Remaining premium-document unlocks from the upload reward. Starts at 2
  // when the reward is granted, decremented by tryConsumeUploadRewardCredit
  // (lib/upload-reward.ts) the first time each distinct premium document is
  // opened — reopening an already-unlocked document never costs another.
  uploadPremiumCredits  Int              @default(0)
  // @default(cuid()) exists so NextAuth's PrismaAdapter — which creates
  // Google sign-in users directly via prisma.user.create() and has no idea
  // this column exists — never violates the NOT NULL/unique constraint.
  // events.createUser in lib/auth.ts immediately replaces it with a proper
  // short generated code.
  referralCode       String           @unique @default(cuid())
  referredById       String?
  referralRewardedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  accounts           Account[]
  sessions           Session[]
  bookmarks          Bookmark[]
  downloads          Download[]
  views              View[]
  paymentRequests    PaymentRequest[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  merchListings      MerchListing[]   @relation("MerchSeller")
  merchSaves         MerchSave[]
  referredBy         User?            @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]           @relation("Referrals")
  referralsMade      Referral[]       @relation("ReferrerOf")
  referralAsReferred Referral?        @relation("ReferredAs")
  referralRewards    ReferralReward[]
  bugReports         BugReport[]
  bugComments        BugComment[]
  contentRequests    ContentRequest[]
  contactMessages    ContactMessage[]
  contentSubmissions ContentSubmission[]
  uploadRewardUnlocks UploadRewardUnlock[]

  @@index([email])
  @@index([membershipStatus])
  @@index([referralCode])
  @@index([referredById])
  @@index([lastActiveAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  shortName String    @unique
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  label     String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  // Nullable: most existing catalog rows predate this field and were never
  // assigned an official credit value. The SGPA calculator pre-fills from
  // this when set and otherwise falls back to a clearly-editable default —
  // it never presents a guessed number as authoritative.
  credits     Int?
  branchId    String
  semesterId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  semester    Semester @relation(fields: [semesterId], references: [id])
  notes       Note[]
  pyqs        PYQ[]

  @@unique([name, branchId, semesterId])
  @@index([branchId, semesterId])
}

model Note {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description      String?
  contentType      ContentType @default(NOTE)
  subjectId        String
  branchId         String
  semesterId       String
  telegramFileId   String
  telegramMsgId    String
  thumbnailUrl     String?
  isPremium        Boolean     @default(false)
  isPublished      Boolean     @default(true)
  downloadCount    Int         @default(0)
  viewCount        Int         @default(0)
  fileSize         Int?
  totalPages       Int?
  uploadedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  subject          Subject     @relation(fields: [subjectId], references: [id])
  branch           Branch      @relation(fields: [branchId], references: [id])
  semester         Semester    @relation(fields: [semesterId], references: [id])
  bookmarks        Bookmark[]
  downloads        Download[]
  views            View[]
  tags             NoteTag[]
  academicBranch   String?
  academicSemester String?
  classYear        String?
  // SHA-256 of the raw uploaded bytes, before compression — see
  // lib/duplicate-detection.ts. Nullable: rows created before this field
  // existed have no hash and are simply never matched by it.
  fileHash         String?

  @@index([subjectId])
  @@index([branchId, semesterId])
  @@index([isPremium])
  @@index([viewCount])
  @@index([fileHash])
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  tag    String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([tag])
}

model PYQ {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String?
  year             Int
  examType         String     @default("End Semester")
  subjectId        String
  branchId         String
  semesterId       String
  telegramFileId   String
  telegramMsgId    String
  isPremium        Boolean    @default(false)
  isPublished      Boolean    @default(true)
  downloadCount    Int        @default(0)
  viewCount        Int        @default(0)
  fileSize         Int?
  uploadedById     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  subject          Subject    @relation(fields: [subjectId], references: [id])
  branch           Branch     @relation(fields: [branchId], references: [id])
  semester         Semester   @relation(fields: [semesterId], references: [id])
  bookmarks        Bookmark[]
  downloads        Download[]
  views            View[]
  academicBranch   String?
  academicSemester String?
  classYear        String?
  // Curated by an admin/moderator, not derived from the title — a paper
  // predicting likely exam questions, distinct from an actual past paper.
  isMostExpected   Boolean    @default(false)
  // SHA-256 of the raw uploaded bytes, before compression — see
  // lib/duplicate-detection.ts.
  fileHash         String?

  @@index([year])
  @@index([branchId, semesterId])
  @@index([subjectId])
  @@index([fileHash])
  @@index([isMostExpected])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@unique([userId, pyqId])
  @@index([userId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model View {
  id        String   @id @default(cuid())
  userId    String?
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([pyqId])
  @@index([createdAt])
}

model PaymentRequest {
  id             String        @id @default(cuid())
  userId         String
  transactionId  String
  screenshotUrl  String
  amount         Float         @default(299)
  status         PaymentStatus @default(PENDING)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  membershipDays Int           @default(365)
  telegramSent   Boolean       @default(true)
  telegramError  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  isActive  Boolean   @default(true)
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model MerchListing {
  id                   String               @id @default(cuid())
  title                String
  slug                 String               @unique
  category             MerchCategory
  price                Float
  isNegotiable         Boolean              @default(false)
  condition            ProductCondition
  description          String
  location             String?
  whatsapp             String
  sellerId             String
  status               ListingStatus        @default(PENDING)
  rejectionReason      String?
  awaitingCustomReason Boolean              @default(false)
  viewCount            Int                  @default(0)
  telegramMessageId    Int?
  telegramSent         Boolean              @default(false)
  telegramError        String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  seller               User                 @relation("MerchSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  images               MerchImage[]
  moderationLogs       MerchModerationLog[]
  saves                MerchSave[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model MerchImage {
  id        String       @id @default(cuid())
  listingId String
  url       String
  path      String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model MerchModerationLog {
  id        String       @id @default(cuid())
  listingId String
  action    String
  reason    String?
  adminId   String?
  createdAt DateTime     @default(now())
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model MerchSave {
  id        String       @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   MerchListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referrer      User           @relation("ReferrerOf", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String         @unique
  referred      User           @relation("ReferredAs", fields: [referredId], references: [id], onDelete: Cascade)
  status        ReferralStatus @default(PENDING)
  ipAddress     String?
  invalidReason String?
  validatedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([referrerId, status])
  @@index([createdAt])
}

model ReferralReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   Int
  grantedDays Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model BugReport {
  id               String       @id @default(cuid())
  bugId            String       @unique
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  title            String
  category         BugCategory
  description      String
  stepsToReproduce String?
  expectedBehavior String?
  actualBehavior   String?
  severity         BugSeverity  @default(MEDIUM)
  status           BugStatus    @default(SUBMITTED)
  priority         Int?
  pageUrl          String?
  browserInfo      String?
  deviceInfo       String?
  os               String?
  screenResolution String?
  appVersion       String?
  contactEmail     String?
  screenshotUrl    String?
  recordingUrl     String?
  internalNotes    String?
  ipAddress        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  comments         BugComment[]

  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
}

model BugComment {
  id        String    @id @default(cuid())
  bugId     String
  bug       BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isAdmin   Boolean   @default(false)
  message   String
  createdAt DateTime  @default(now())

  @@index([bugId])
}

// Premium-only: a student asks for a specific paper/note that isn't on the
// site yet. branch/semester are free text, not FKs to Branch/Semester — the
// request is exactly for content that doesn't exist in the catalog yet, so
// there's nothing to link against until an admin fulfills it.
model ContentRequest {
  id            String        @id @default(cuid())
  requestCode   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String
  branch        String?
  semester      String?
  status        RequestStatus @default(PENDING)
  // Admin-facing reply shown back to the requester (rejection reason,
  // progress note, or a pointer to where the fulfilled content now lives).
  adminResponse String?
  fulfilledUrl  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Open to everyone, logged in or not — deliberately NOT tied to a User
// account: `email` is whatever personal address the visitor typed in, since
// that's where the admin replies, not necessarily their account email.
model ContactMessage {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String?
  email       String
  message     String
  ipAddress   String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([respondedAt])
  @@index([createdAt])
}

// A student-submitted Note/PYQ awaiting Telegram-based admin review — see
// lib/telegram-submissions.ts / lib/submission-moderation.ts. On approval, a
// real Note or PYQ row is created from this data (publishedType/
// publishedSlug then point at it) and lib/upload-reward.ts checks whether
// this pushed the uploader's approved-submission count to the reward
// threshold.
model ContentSubmission {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  contentType        ContentType      @default(NOTE)
  examType           String?
  academicBranch     String
  academicSemester   String
  classYear          String
  subjectName        String
  telegramFileId     String
  telegramMsgId      String
  fileSize           Int?
  // SHA-256 of the raw uploaded bytes, before compression — computed once
  // at submission time and carried onto the published Note/PYQ on approval
  // (see lib/duplicate-detection.ts, approveSubmission in
  // lib/submission-moderation.ts).
  fileHash           String?
  // Populated at submission time by lib/duplicate-detection.ts — a
  // human-readable heads-up for the reviewer (exact file match, or a
  // same-subject/branch/semester title match against existing content).
  // Purely informational: never blocks or auto-rejects a submission, the
  // admin decides.
  duplicateNote      String?
  status             SubmissionStatus @default(PENDING)
  rejectionReason    String?
  // Set once approved — where the resulting live document actually lives.
  publishedType      String?
  publishedSlug      String?
  telegramSent       Boolean          @default(false)
  telegramMessageId  Int?
  telegramError      String?
  // Mirrors MerchListing's awaitingCustomReason: set when an admin picks
  // "Other" on the Telegram reject-reason menu, so the next text reply to
  // that message is understood as the custom reason rather than an
  // unrelated message.
  awaitingCustomReason Boolean        @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([fileHash])
}

// One row per (user, document) the upload reward has unlocked — the actual
// "has this specific document already been paid for with a credit" record.
// Existence of a row means no further credit is charged on repeat opens
// within the active window; expiry (15 days from
// User.uploadRewardGrantedAt) is checked at read time, not by deleting rows.
model UploadRewardUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?
  pyqId     String?
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
  @@unique([userId, pyqId])
  @@index([userId])
}
