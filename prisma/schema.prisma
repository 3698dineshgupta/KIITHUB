generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  MODERATOR
}

enum MembershipStatus {
  FREE
  PENDING
  PREMIUM
  EXPIRED
}

enum ContentType {
  NOTE
  PYQ
  SYLLABUS
  LAB_MANUAL
  ASSIGNMENT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  NEW_NOTE
  NEW_PYQ
  ANNOUNCEMENT
  SYSTEM
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  college          String?
  university       String?
  role             Role             @default(STUDENT)
  membershipStatus MembershipStatus @default(FREE)
  membershipExpiry DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  bookmarks        Bookmark[]
  downloads        Download[]
  views            View[]
  paymentRequests  PaymentRequest[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  @@index([email])
  @@index([membershipStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  shortName String    @unique
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  label     String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  notes     Note[]
  pyqs      PYQ[]
}

model Subject {
  id          String    @id @default(cuid())
  name        String
  code        String?
  description String?
  branchId    String
  semesterId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch    @relation(fields: [branchId], references: [id])
  semester    Semester  @relation(fields: [semesterId], references: [id])
  notes       Note[]
  pyqs        PYQ[]
  @@unique([name, branchId, semesterId])
  @@index([branchId, semesterId])
}

model Note {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  description    String?
  contentType    ContentType @default(NOTE)
  subjectId      String
  branchId       String
  semesterId     String
  telegramFileId String
  telegramMsgId  String
  thumbnailUrl   String?
  isPremium      Boolean     @default(false)
  isPublished    Boolean     @default(true)
  downloadCount  Int         @default(0)
  viewCount      Int         @default(0)
  fileSize       Int?
  totalPages     Int?
  uploadedById   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  subject        Subject     @relation(fields: [subjectId], references: [id])
  branch         Branch      @relation(fields: [branchId], references: [id])
  semester       Semester    @relation(fields: [semesterId], references: [id])
  bookmarks      Bookmark[]
  downloads      Download[]
  views          View[]
  tags           NoteTag[]
  academicBranch   String?
  academicSemester String?
  classYear        String?
  @@index([subjectId])
  @@index([branchId, semesterId])
  @@index([isPremium])
  @@index([viewCount])
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  tag    String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId])
  @@index([tag])
}

model PYQ {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String?
  year           Int
  examType       String    @default("End Semester")
  subjectId      String
  branchId       String
  semesterId     String
  telegramFileId String
  telegramMsgId  String
  isPremium      Boolean   @default(false)
  isPublished    Boolean   @default(true)
  downloadCount  Int       @default(0)
  viewCount      Int       @default(0)
  fileSize       Int?
  uploadedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  subject        Subject   @relation(fields: [subjectId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  semester       Semester  @relation(fields: [semesterId], references: [id])
  bookmarks      Bookmark[]
  downloads      Download[]
  views          View[]
  academicBranch   String?
  academicSemester String?
  classYear        String?
  @@index([year])
  @@index([branchId, semesterId])
  @@index([subjectId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)
  @@unique([userId, noteId])
  @@unique([userId, pyqId])
  @@index([userId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([createdAt])
}

model View {
  id        String   @id @default(cuid())
  userId    String?
  noteId    String?
  pyqId     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyq       PYQ?     @relation(fields: [pyqId], references: [id], onDelete: Cascade)
  @@index([noteId])
  @@index([pyqId])
  @@index([createdAt])
}

model PaymentRequest {
  id             String        @id @default(cuid())
  userId         String
  transactionId  String
  screenshotUrl  String
  amount         Float         @default(299)
  status         PaymentStatus @default(PENDING)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  membershipDays Int           @default(365)
  telegramSent   Boolean       @default(true)
  telegramError  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  isActive  Boolean   @default(true)
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([createdAt])
}
